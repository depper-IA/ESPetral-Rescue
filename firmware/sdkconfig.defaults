# CALI CSI Node - Default SDK Configuration (común a todos los targets)
#
# Target selection (no se define aquí, usar `idf.py set-target`):
#   idf.py set-target esp32s3    # o esp32c6 / esp32c3
#
# Defaults por chip (LED GPIO):
# Ver sdkconfig.defaults.esp32c3, .esp32c6, .esp32s3
# Esos archivos se aplican DESPUÉS de este según docs de ESP-IDF v5.

# Partition table (común a los 3 targets)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size: 4MB como piso común a los 3 targets.
#
# Este valor es DELIBERADAMENTE conservador. El flash físico varía por
# placa: la S3 de pruebas medida con `esptool flash_id` reporta 16MB
# (Device 4018) + 8MB de PSRAM, mientras que las variantes Super Mini de
# C3/C6 traen 4MB. Como partitions.csv es único para los 3 targets, se
# dimensiona contra la placa más chica: configurar un flash MAYOR al
# físico rompe el arranque, configurar uno menor solo deja espacio sin
# usar. La tabla ocupa 0x3A0000 (3.63MB) y entra en 4MB.
#
# Sin este símbolo el build cae en el default de ESP-IDF (2MB), donde la
# tabla NO entra y el build falla.
#
# Si en el futuro se estandariza el hardware en placas de 16MB, conviene
# subir este valor y agrandar los slots OTA (hay 12MB sin usar en la S3).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# NVS
CONFIG_NVS_ENCRYPTION=n

# Wi-Fi
CONFIG_ESP_WIFI_MODE_STA=y
CONFIG_ESP_WIFI_CSI_ENABLED=y

# MQTT (v3.1.1 — protocolVersion 4 en cliente, igual que C6/S3/C3)
CONFIG_MQTT_PROTOCOL_5=n

# Power management
CONFIG_PM_ENABLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y